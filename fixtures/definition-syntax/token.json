{
    "slash": {
        "syntax": "foo / bar",
        "valid": [
            "foo / bar",
            "foo/bar"
        ],
        "invalid": [
            "",
            "/",
            "foo",
            "foo /",
            "foo bar",
            "bar",
            "/ bar"
        ]
    },
    "semicolon": {
        "syntax": "foo ; bar",
        "valid": [
            "foo ; bar",
            "foo;bar"
        ],
        "invalid": [
            "",
            ";",
            "foo",
            "foo ;",
            "foo bar",
            "bar",
            "; bar"
        ]
    },
    "token with a multiplier": {
        "syntax": ";?",
        "valid": [
            " ; ",
            ";",
            "  ",
            ""
        ],
        "invalid": []
    },
    "optional comma": {
        "syntax": ",?",
        "valid": [
            "",
            " ",
            ",",
            " , "
        ],
        "invalid": [
            ",,",
            "foo"
        ]
    },
    "one or more commas": {
        "syntax": ",+",
        "valid": [
            ",",
            ",,",
            " , , "
        ],
        "invalid": [
            "",
            "foo"
        ]
    },
    "optional trailing comma": {
        "syntax": "<ident># ,?",
        "valid": [
            "a",
            "a,",
            "a, b",
            "a, b,"
        ],
        "invalid": [
            "",
            ",",
            "a,,"
        ]
    }
}
